"""
PROYECTO SOFTWARE FJ
MODULO CENTRAL DE EXCEPCIONES
"""

class SistemaError(Exception):
    """Excepcion base del sistema Software FJ."""
    pass


class ServicioError(SistemaError):
    """Excepcion general de los servicios."""
    pass


class ServicioInvalidDataError(ServicioError):
    """Error en los datos de los servicios."""
    pass


class ServicioNoDisponibleError(ServicioError):
    """Error cuando un servicio no esta disponible."""
    pass
